FROM python:3.12-slim

LABEL org.opencontainers.image.title="LBRO API"
LABEL org.opencontainers.image.description="Law-aware Breach Response Orchestrator — API"

RUN groupadd --gid 1000 lbro && useradd --uid 1000 --gid lbro --no-create-home lbro

# build-essential + libpq-dev needed to compile psycopg2 / asyncpg C extensions.
# libpq5 is the PostgreSQL client runtime library.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --prefer-binary -r requirements.txt

COPY backend/ .

ARG ML_MODEL_SIGNING_KEY=""

# backend/alembic/ conflicts with the installed alembic package when PYTHONPATH=/app.
RUN rm -rf /app/alembic

RUN mkdir -p /app/ml/models && chown -R lbro:lbro /app

# Sign bundle at image build when release pipeline passes ML_MODEL_SIGNING_KEY build-arg.
ENV ML_MODEL_BUNDLE_DIR="/app/app/ml/models/bundle"
COPY scripts/sign_model.py /tmp/ml-scripts/sign_model.py
RUN if [ -n "$ML_MODEL_SIGNING_KEY" ]; then \
      PYTHONPATH=/app ML_MODEL_BUNDLE_DIR=/app/app/ml/models/bundle ENVIRONMENT=production \
      python /tmp/ml-scripts/sign_model.py --bundle-dir /app/app/ml/models/bundle ; \
    fi && rm -rf /tmp/ml-scripts

ENV PYTHONPATH="/app" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER lbro

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "2", "--loop", "uvloop", "--no-access-log"]
